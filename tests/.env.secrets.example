# Copy this file to .env.secrets and fill in the credentials for your test S3 endpoint.
# The integration tests (to be written) can load these variables to exercise the storage backend.

AWS_ACCESS_KEY_ID=example-access-key
AWS_SECRET_ACCESS_KEY=example-secret-key
AWS_DEFAULT_REGION=us-east-1
WPLACE_TEST_S3_BUCKET=wplace-test-bucket
WPLACE_TEST_ENDPOINT_URL=https://s3.local.test
